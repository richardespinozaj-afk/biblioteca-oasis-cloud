    fill: {type: solid, color: "#9e9e9e"}
  - elementId: arrow2
    elementType: icon
    bounds: [472, 155, 16, 16]
    iconName: "fas:arrow-right"
    fill: {type: solid, color: "#9e9e9e"}
  - elementId: arrow3
