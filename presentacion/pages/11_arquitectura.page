pageType: content
background:
  type: solid
  color: "#ffffff"
elements:
  - elementId: header-bar
    elementType: shape
    bounds: [0, 0, 960, 50]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: header-title
    elementType: text
    bounds: [30, 0, 500, 50]
    content:
      color: "#ffffff"
      fontSize: 20
      bold: true
      align: [left, middle]
      text: "5. Mostrar la solución - Arquitectura 4 Capas"
  - elementId: capa1-box
    elementType: shape
    bounds: [50, 80, 200, 180]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "#e8f0fe"}
    border: {style: solid, width: 2, color: "$primary"}
