pageType: final
background:
  type: gradient
  gradientType: linear
  angle: 135
  stops:
    - {position: 0, color: "#1a73e8"}
    - {position: 1, color: "#0d47a1"}
elements:
  - elementId: icon-thanks
    elementType: icon
    bounds: [430, 120, 100, 100]
    iconName: "fas:hands-clapping"
    fill: {type: solid, color: "#ffffff"}
  - elementId: thanks-text
    elementType: text
    bounds: [80, 240, 800, 60]
    content:
      fontSize: 42
      bold: true
      color: "#ffffff"
      align: [center, middle]
      text: "¡Gracias!"
  - elementId: subtitle
    elementType: text
    bounds: [80, 310, 800, 40]
    content:
      fontSize: 20
      color: "#e8f0fe"
      align: [center, middle]
      text: "Biblioteca Oasis - Integración de Servicios Cloud GCP"
  - elementId: team-text
    elementType: text
    bounds: [80, 370, 800, 60]
    content:
      fontSize: 14
      color: "#e8f0fe"
      align: [center, middle]
      text: |
        <p>[Integrante 1] | [Integrante 2] | [Integrante 3] | [Integrante 4] | [Integrante 5]</p>
  - elementId: questions
    elementType: text
    bounds: [80, 440, 800, 40]
    content:
      fontSize: 18
      color: "#fbbc04"
      align: [center, middle]
      text: "¿Preguntas?"
