pageType: content
background:
  type: solid
  color: "#ffffff"
elements:
  - elementId: header-bar
    elementType: shape
    bounds: [0, 0, 960, 50]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: header-title
    elementType: text
    bounds: [30, 0, 500, 50]
    content:
      color: "#ffffff"
      fontSize: 20
      bold: true
      align: [left, middle]
      text: "6. Conclusiones"
  - elementId: c1-bg
    elementType: shape
    bounds: [50, 80, 420, 70]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "#e8f0fe"}
  - elementId: c1-num
    elementType: shape
    bounds: [60, 90, 30, 30]
    shapeName: ellipse
    fill: {type: solid, color: "$primary"}
  - elementId: c1-numtext
    elementType: text
    bounds: [60, 90, 30, 30]
    content:
      fontSize: 14
      bold: true
      color: "#ffffff"
      align: [center, middle]
      text: "1"
  - elementId: c1-text
    elementType: text
    bounds: [100, 85, 360, 55]
    content:
      fontSize: 12
      lineHeight: 1.4
      align: [left, middle]
      text: |
        <p>La organización requiere modernización tecnológica urgente debido a las limitaciones del sistema legacy.</p>
