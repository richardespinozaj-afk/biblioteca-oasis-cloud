    elementType: shape
    bounds: [0, 0, 960, 50]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: header-title
    elementType: text
    bounds: [30, 0, 400, 50]
    content:
      color: "#ffffff"
      fontSize: 20
      bold: true
      align: [left, middle]
      text: Agenda
  - elementId: item1-num
    elementType: shape
    bounds: [80, 100, 50, 50]
