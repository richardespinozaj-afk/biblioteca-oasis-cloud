pageType: content
background:
  type: solid
  color: "#ffffff"
elements:
  - elementId: header-bar
    elementType: shape
    bounds: [0, 0, 960, 50]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: header-title
    elementType: text
    bounds: [30, 0, 500, 50]
    content:
      color: "#ffffff"
      fontSize: 20
      bold: true
      align: [left, middle]
      text: "3. Requerimientos no funcionales"
  - elementId: nf1-bg
    elementType: shape
    bounds: [50, 80, 280, 130]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "#e8f0fe"}
  - elementId: nf1-icon
    elementType: icon
    bounds: [160, 95, 40, 40]
    iconName: "fas:clock"
    fill: {type: solid, color: "$primary"}
  - elementId: nf1-title
    elementType: text
    bounds: [60, 140, 260, 25]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      align: [center, middle]
      text: "Disponibilidad"
  - elementId: nf1-desc
    elementType: text
    bounds: [60, 168, 260, 35]
    content:
      fontSize: 12
      align: [center, middle]
      text: "24/7 con uptime mínimo del 99.9%"
  - elementId: nf2-bg
